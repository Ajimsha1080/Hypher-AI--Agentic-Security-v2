{
  "name": "mcp-security-gateway",
  "version": "3.3.0",
  "description": "Production-grade Zero-Trust Security Proxy for MCP AI Agents — Full Enterprise Edition",
  "main": "dist/proxy/server.js",
  "scripts": {
    "dev": "nodemon src/proxy/server.ts",
    "build": "tsc && node scripts/copy-dashboard-assets.js",
    "start": "node dist/proxy/server.js",
    "test": "jest --coverage",
    "test:e2e": "jest --testPathPattern=enterprise-e2e --runInBand",
    "test:security": "jest --testPathPattern=security",
    "docker:up": "docker compose up --build -d",
    "docker:down": "docker compose down",
    "db:migrate": "ts-node src/scripts/migrate.ts",
    "mcp:configure": "node scripts/configure-external-mcp.js",
    "mcp:test-upstream": "node scripts/test-external-mcp.js",
    "mcp:create-local-agent": "node scripts/create-local-agent.js",
    "mcp:start-external-codex": "node scripts/external-codex-mcp-server.js",
    "benchmark": "BENCHMARK_TOKEN=$BENCHMARK_TOKEN ts-node src/benchmark/run.ts",
    "soc2:evidence": "ts-node src/soc2-cert/cli.ts",
    "health": "curl -s http://localhost:3000/health/ready",
    "cloud:provision": "ts-node src/cloud/provision.ts"
  },
  "keywords": [
    "mcp",
    "security",
    "zero-trust",
    "gateway",
    "langchain",
    "crewai",
    "autogen",
    "enterprise"
  ],
  "author": "Antigravity",
  "license": "Apache-2.0",
  "engines": {
    "node": ">=18.0.0"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.24.0",
    "@fastify/cookie": "^9.3.1",
    "@fastify/cors": "^11.2.0",
    "@fastify/helmet": "^13.0.2",
    "@fastify/rate-limit": "^10.3.0",
    "@fastify/static": "^7.0.4",
    "@fastify/websocket": "^11.2.0",
    "@types/bcryptjs": "^2.4.6",
    "axios": "^1.13.2",
    "bcryptjs": "^3.0.3",
    "cheerio": "^1.2.0",
    "dotenv": "^17.2.3",
    "fastify": "^5.6.2",
    "ioredis": "^5.8.2",
    "jose": "^5.9.6",
    "nodemailer": "^6.9.13",
    "pg": "^8.16.3",
    "pino": "^10.1.0",
    "pino-pretty": "^13.1.3",
    "resend": "^3.2.0",
    "stripe": "^14.25.0",
    "uuid": "^13.0.0",
    "zod": "^4.2.1"
  },
  "devDependencies": {
    "@types/jest": "^29.5.14",
    "@types/node": "^25.0.3",
    "@types/pg": "^8.16.0",
    "@types/uuid": "^10.0.0",
    "eslint": "^9.39.2",
    "jest": "^29.7.0",
    "nodemon": "^3.1.11",
    "ts-jest": "^29.4.9",
    "ts-node": "^10.9.2",
    "typescript": "^5.9.3"
  }
}
