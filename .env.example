# ── Core (required) ──────────────────────────────────────────────────────
NODE_ENV=production
DATABASE_URL=postgresql://mcp_admin:your_password@localhost:5432/mcp_security
REDIS_URL=redis://localhost:6379
JWT_SECRET=change_this_to_a_random_32_char_string_minimum
FAIL_MODE=fail_closed
MCP_SERVER_URL=http://your-mcp-tool-server:8080
PORT=3000
LOG_LEVEL=info
RATE_LIMIT_MAX=100
MCP_TIMEOUT_MS=30000

# ── Development / Demo ─────────────────────────────────────────────────
MOCK_UPSTREAM=false

# ── OAuth 2.1 / OIDC ──────────────────────────────────────────────────
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
AZURE_CLIENT_ID=
AZURE_CLIENT_SECRET=
AZURE_TENANT_ID=
OKTA_ISSUER=
OKTA_CLIENT_ID=
OKTA_CLIENT_SECRET=
OKTA_AUDIENCE=
SSO_AUTO_PROVISION=false

# ── Dashboard ─────────────────────────────────────────────────────────
ENABLE_DASHBOARD=true
ENABLE_WEBSOCKET=true
ADMIN_SECRET=change_this_random_secret_32_chars
ADMIN_EMAIL=you@yourcompany.com
APP_URL=https://your-gateway.com
ALLOWED_ORIGINS=https://your-gateway.com

# ── Billing (Stripe) ──────────────────────────────────────────────────
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PRICE_STARTER=
STRIPE_PRICE_GROWTH=
STRIPE_PRICE_ENTERPRISE=
STRIPE_PRICE_CLOUD=

# ── Email ─────────────────────────────────────────────────────────────
EMAIL_PROVIDER=resend
EMAIL_API_KEY=
EMAIL_FROM=MCP Security <noreply@mcpsecurity.io>

# ── Sprint 1: Managed Cloud Tier ──────────────────────────────────────
CLOUD_DOMAIN=mcpsecurity.dev

# ── Sprint 3: HITL ────────────────────────────────────────────────────
HITL_APPROVER_EMAIL=security@yourcompany.com
HITL_SLACK_WEBHOOK=
HITL_TIMEOUT_MINUTES=15

# ── Sprint 1+3: SIEM ──────────────────────────────────────────────────
SIEM_TYPE=splunk
SIEM_ENDPOINT=
SIEM_API_KEY=

# ── Sprint 3: SLA ─────────────────────────────────────────────────────
ENABLE_SLA_TRACKING=true
SLA_UPTIME_TARGET=99.9

# ── Benchmark ─────────────────────────────────────────────────────────
BENCHMARK_TOKEN=

# ── Advanced ──────────────────────────────────────────────────────────
MAX_ARGS_LENGTH=65536
AUDIT_LOG_RETENTION_DAYS=90
DLP_HIPAA_MODE=false
